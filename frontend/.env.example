# Copy file này thành .env rồi điền. KHÔNG commit .env (đã .gitignore).
# ⚠️ Mọi biến VITE_* sẽ được build thẳng vào bundle public của trình duyệt
#    → KHÔNG bao giờ để secret/service key ở đây. Chỉ dùng client-id & anon (publishable) key.
VITE_GOOGLE_CLIENT_ID=<your-google-client-id>
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-publishable-key>
