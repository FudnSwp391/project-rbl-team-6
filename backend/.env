DATABASE_URL=postgresql://postgres.qrdnebeulfdgfeermghj:cungnhauthukhoa@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google OAuth Client ID (giống bên frontend)
GOOGLE_CLIENT_ID=586502013035-81tfga362871gkl2csbtkm8e176h3gp4.apps.googleusercontent.com

# JWT secret — đổi thành chuỗi ngẫu nhiên dài trước khi deploy
