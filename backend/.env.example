# ============================================================
# Copy file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env (đã được .gitignore bỏ qua).
# Connection string: Supabase → Project Settings → Database → Connection string → URI
# ⚠️ HOST phải là aws-1-ap-southeast-1 (aws-0 đã bị Supabase ngừng → "tenant/user not found")
# ============================================================
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google OAuth Client ID (giống bên frontend)
GOOGLE_CLIENT_ID=<your-google-client-id>

# JWT secret — chuỗi ngẫu nhiên dài, mỗi người tự sinh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<chuoi-ngau-nhien-dai-it-nhat-32-ky-tu>

# URL frontend (để CORS cho phép)
FRONTEND_ORIGIN=http://localhost:5173

# Port backend
PORT=5000

# ─── Nodemailer / SMTP ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<gmail-app-password>
SMTP_FROM=EduX <your-email@gmail.com>

# ─── Supabase Storage ────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=<supabase-service-role-key>

# ─── AI keys ─────────────────────────────────────────────────
GROQ_API_KEY=<groq-api-key>
GEMINI_API_KEY=<gemini-api-key>

# ─── VNPAY (sandbox) ─────────────────────────────────────────
VNPAY_TMN_CODE="<vnpay-tmn-code>"
VNPAY_SECRET_KEY="<vnpay-secret-key>"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# ─── Email demo ──────────────────────────────────────────────
# Hộp thư CHUNG: mọi email thông báo đổ về 1 địa chỉ (tiêu đề ghi kèm
# người nhận gốc). Xóa/để trống nếu muốn gửi đúng email từng người dùng.
EMAIL_DEMO_REDIRECT=
