# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — copy thành backend/.env và điền giá trị thật.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (Supabase) — bắt buộc
DATABASE_URL=postgresql://user:password@host:5432/postgres

# JWT — bắt buộc, đặt chuỗi ngẫu nhiên dài
JWT_SECRET=change_me_to_a_long_random_string

# Server
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth (đăng nhập Google)
GOOGLE_CLIENT_ID=

# Supabase Storage (upload file qua presigned URL)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email (Nodemailer) — nếu bỏ trống, server bỏ qua việc gửi mail (không crash)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduX <no-reply@edux.vn>"
# Chuyển hướng toàn bộ email về 1 địa chỉ khi demo (tùy chọn)
EMAIL_DEMO_REDIRECT=

# AI (Gemini chính, Groq fallback) — tùy chọn, thiếu key thì tính năng AI tắt êm
GEMINI_API_KEY=
GROQ_API_KEY=
# Nhiều key Groq xoay vòng, phân tách bằng dấu phẩy (tùy chọn)
GROQ_API_KEYS=

# VNPay sandbox (nạp ví)
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Tùy chọn nâng cao (thường KHÔNG cần đặt)
# ADMIN_WALLET_ID=            # UUID ví admin; bỏ trống sẽ tự tìm user role=admin
# ADMIN_COPILOT_PROVIDER=gemini
# SEMANTIC_MODERATION_PROVIDER=gemini
# FRAUD_INTEL_PROVIDER=gemini
# ADMIN_ANALYTICS_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash-lite
